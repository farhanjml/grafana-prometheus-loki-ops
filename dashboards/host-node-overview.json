    {"name": "instance", "label": "Instance", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "definition": "label_values(node_cpu_seconds_total{job=~\"$job\"}, instance)", "query": {"query": "label_values(node_cpu_seconds_total{job=~\"$job\"}, instance)", "refId": "StandardVariableQuery"}, "refresh": 1, "multi": true, "includeAll": true, "allValue": ".+", "current": {"selected": true, "text": "All", "value": "$__all"}, "options": []}
